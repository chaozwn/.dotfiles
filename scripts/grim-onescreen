#!/usr/bin/env bash
# Flameshot calls `grim -t ppm <file>` and then sizes its editor to that image.
# A physical capture of the 1.75x laptop panel is larger than the panel's
# logical size, so the editor spills onto the other monitor. Capture the chosen
# output, then scale it to that output's logical size.
set -euo pipefail

real=/usr/bin/grim
request="${XDG_RUNTIME_DIR:-/tmp}/flameshot-output"

wants_ppm=0
for arg in "$@"; do
  if [[ "$arg" == "ppm" ]]; then
    wants_ppm=1
    break
  fi
done

if [[ "$wants_ppm" != 1 || ! -f "$request" ]]; then
  exec "$real" "$@"
fi

output=$(tr -d '\n' <"$request")
rm -f "$request"
if [[ -z "$output" ]]; then
  exec "$real" "$@"
fi

"$real" -o "$output" "$@"

dest=""
skip_next=0
for arg in "$@"; do
  if [[ "$skip_next" == 1 ]]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    -t|-s|-o|-g|--scale)
      skip_next=1
      ;;
    -*)
      ;;
    *)
      dest=$arg
      ;;
  esac
done

if [[ -z "$dest" || ! -f "$dest" ]]; then
  exit 0
fi

read -r width height scale < <(niri msg --json outputs | /usr/bin/python3 -c '
import json, sys
name = sys.argv[1]
outputs = json.load(sys.stdin)
info = outputs.get(name)
if info is None:
    raise SystemExit(1)
logical = info["logical"]
print(int(logical["width"]), int(logical["height"]), logical["scale"])
' "$output") || exit 0

if awk "BEGIN { exit !($scale == 1) }"; then
  exit 0
fi

scaled=$(mktemp --suffix=.ppm)
magick "$dest" -filter Lanczos -resize "${width}x${height}!" "$scaled"
mv "$scaled" "$dest"
